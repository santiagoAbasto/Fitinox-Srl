Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L,NC]
    RewriteRule "(^|/)(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.(js|ts))$" - [F,L,NC]
    RewriteRule "\.(env|ini|log|sql|bak|backup|zip|tar|gz|key|pem|phar|phtml|pht|cgi|pl|py|sh)$" - [F,L,NC]
    RewriteRule "^(storage|uploads?)/.*\.(php[0-9]?|phtml|pht|phar|cgi|pl|py|sh)$" - [F,L,NC]
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
